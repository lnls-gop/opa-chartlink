# Produção: diretórios no disco LOCAL do servidor, fora do código.
CHARTLINK_DATA_DIR=/var/lib/chartlink/data
CHARTLINK_BACKUP_DIR=/var/backups/chartlink

# Para acesso pela rede, substitua pelo IP LAN do servidor.
# 127.0.0.1 permite primeiro validar apenas no próprio servidor.
CHARTLINK_BIND_IP=127.0.0.1
CHARTLINK_PORT=8080
