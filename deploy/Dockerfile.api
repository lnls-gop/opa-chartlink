FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/app/backend
WORKDIR /app
COPY backend/requirements.txt /app/backend/requirements.txt
RUN pip install --no-cache-dir -r /app/backend/requirements.txt \
    && groupadd --gid 10001 chartlink \
    && useradd --uid 10001 --gid 10001 --no-create-home chartlink \
    && install -d -o 10001 -g 10001 /data /backups
COPY backend /app/backend
COPY scripts/database.py /app/scripts/database.py
COPY deploy/api-entrypoint.sh /app/deploy/api-entrypoint.sh
COPY deploy/gunicorn.conf.py /app/deploy/gunicorn.conf.py
USER 10001:10001
EXPOSE 5000
ENTRYPOINT ["sh", "/app/deploy/api-entrypoint.sh"]
